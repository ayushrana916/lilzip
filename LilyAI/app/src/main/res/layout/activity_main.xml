<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬡"
                android:textSize="52sp"
                android:textColor="#378ADD" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L.I.L.Y."
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#E0EEFF"
                android:letterSpacing="0.15"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logical Intelligent Lifelike Youth"
                android:textSize="11sp"
                android:textColor="#85B7EB"
                android:letterSpacing="0.06"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Step 1: API Key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121228"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 1 — Claude API Key"
                android:textSize="11sp"
                android:textColor="#378ADD"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get free key from: console.anthropic.com"
                android:textSize="11sp"
                android:textColor="#85B7EB"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="sk-ant-..."
                android:hintTextColor="#445566"
                android:textColor="#E0EEFF"
                android:textSize="13sp"
                android:inputType="textPassword"
                android:background="#1A1A3A"
                android:padding="12dp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnSaveKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Save Key &amp; Request Permissions"
                android:backgroundTint="#185FA5"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Step 2: Special permissions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121228"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 2 — Special Permissions"
                android:textSize="11sp"
                android:textColor="#378ADD"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:layout_marginBottom="10dp"/>

            <!-- Notification status -->
            <TextView
                android:id="@+id/tvNotifStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking notification access..."
                android:textSize="12sp"
                android:textColor="#85B7EB"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnNotifAccess"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Enable Notification Access (reads WhatsApp)"
                android:backgroundTint="#0C447C"
                android:textColor="#85B7EB"
                android:textSize="12sp"
                android:layout_marginBottom="10dp"/>

            <!-- Accessibility status -->
            <TextView
                android:id="@+id/tvAccessStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking accessibility access..."
                android:textSize="12sp"
                android:textColor="#85B7EB"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnAccessibility"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Enable Accessibility (controls apps)"
                android:backgroundTint="#0C447C"
                android:textColor="#85B7EB"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Step 3: Start/Stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121228"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP 3 — Activate Lily"
                android:textSize="11sp"
                android:textColor="#378ADD"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="⬡  ACTIVATE LILY"
                android:backgroundTint="#185FA5"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Stop Lily"
                android:backgroundTint="#2A0A0A"
                android:textColor="#E24B4A"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- How to use -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0D1A0D"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOW TO USE"
                android:textSize="11sp"
                android:textColor="#1D9E75"
                android:textStyle="bold"
                android:letterSpacing="0.07"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Say 'Hey Lily' to wake her up — even on lock screen!\n\n🎙 Hey Lily, call Shivam\n💬 Hey Lily, send WhatsApp to Priya saying I'm coming\n🔍 Hey Lily, search IPL score today\n▶️ Hey Lily, play Arijit Singh on YouTube\n📍 Hey Lily, navigate to India Gate Delhi\n⏰ Hey Lily, set alarm for 7 AM\n🔦 Hey Lily, turn on torch\n📱 Hey Lily, open Instagram\n📋 Hey Lily, what did Shivam message me\n🗣 Hey Lily, what is the capital of France"
                android:textSize="12sp"
                android:textColor="#85B7EB"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
